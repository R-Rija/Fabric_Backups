	partition DIM_PRODUCT = m
		mode: import
		source =
				let
				    Source = SharePoint.Files(
				        "https://gwcteq-my.sharepoint.com/personal/rija_ravichandran_gwcdata_ai",
				        [ApiVersion = 15]
				    ),
				
				    File = Source{[Name = "DimProduct.csv"]}[Content],
				
				    DIM_PRODUCT_Table =
				        Table.PromoteHeaders(
				            Csv.Document(
				                File,
				                [
				                    Delimiter = ",",
				                    Encoding = 65001,
				                    QuoteStyle = QuoteStyle.Csv
				                ]
				            ),
				            [PromoteAllScalars = true]
				        ),
				
				    #"Renamed Columns" =
				        Table.RenameColumns(
				            DIM_PRODUCT_Table,
				            {
				                {"ProductID", "PRODUCTID"},
				                {"ProductName", "PRODUCTNAME"},
				                {"Subcategory", "SUBCATEGORY"},
				                {"DepartmentID", "DEPARTMENTID"},
				                {"DepartmentName", "DEPARTMENTNAME"},
				                {"BrandID", "BRANDID"},
				                {"BrandName", "BRANDNAME"},
				                {"ASP", "ASP"}
				            },
				            MissingField.Ignore
				        ),
				
				    #"Added Brand_Name" =
				        Table.AddColumn(
				            #"Renamed Columns",
				            "Brand_Name",
				            each "Novamart",
				            type text
				        ),
				
				    #"Added Brand_ID" =
				        Table.AddColumn(
				            #"Added Brand_Name",
				            "Brand_ID",
				            each 1,
				            Int64.Type
				        )
				
				in
				    #"Added Brand_ID"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

