table DIM_PRODUCT
	lineageTag: 84371775-b63f-40d2-adfd-4e066f9a586e

	measure 'active customer %' = DIVIDE(DISTINCTCOUNT(FACT_SALES[CUSTOMERID]),CALCULATE(FACT_SALES[Active Customer],all(DIM_CUSTOMERS[SEGMENT])))
		displayFolder: bar chart
		lineageTag: eadaa633-0e60-435b-a042-0c0c25e211b3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure zero = 0
		displayFolder: bar chart
		lineageTag: c3a097ad-9c54-454b-b773-e7015f9544f5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column ASP
		dataType: string
		lineageTag: 4ae6bf0a-4668-4b05-a258-7a6496d99463
		summarizeBy: none
		sourceColumn: ASP

		annotation SummarizationSetBy = Automatic

	column Brand_ID
		dataType: int64
		formatString: 0
		lineageTag: 0a4116e9-08d0-4dbc-bf3f-4f53fcd91cbe
		summarizeBy: none
		sourceColumn: Brand_ID

		annotation SummarizationSetBy = Automatic

	column Price_Band =
			
			SWITCH(
			    TRUE(),
			    [ASP] <= 500, "₹0–₹500",
			    [ASP] > 500 && [ASP] <= 2000, "₹501–₹2K",
			    [ASP] > 2000 && [ASP] <= 10000, "₹2K–₹10K",
			    [ASP] > 10000 && [ASP] <= 30000, "₹10K–₹30K",
			    [ASP] > 30000, "₹30K+"
			)
		lineageTag: a311dc78-abb7-4934-98a8-8aa62f9461a6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Price_Band_Sort =
			
			SWITCH(
			    TRUE(),
			    [Price_Band] = "₹0–₹500", 1,
			    [Price_Band] = "₹501–₹2K", 2,
			    [Price_Band] = "₹2K–₹10K", 3,
			    [Price_Band] = "₹10K–₹30K", 4,
			    [Price_Band] = "₹30K+", 5
			)
		formatString: 0
		lineageTag: fa21cc70-7f6b-4bbc-a7f2-cfaaef138391
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Product_Distribution_Pct = ```
			
			DIVIDE(
			    DISTINCTCOUNT(DIM_PRODUCT[PRODUCTID]), 
			    CALCULATE(DISTINCTCOUNT(DIM_PRODUCT[PRODUCTID]), ALL(DIM_PRODUCT[Price_Band]))
			)
			```
		lineageTag: d1665dc4-da26-469c-bd90-3dfeb020e542
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

