table FACT_SALES
	lineageTag: 2cdc9529-250d-49af-954f-aa3055a2b582

	measure Revenue = sum(FACT_SALES[SALESAMOUNT])
		displayFolder: Basic measure
		lineageTag: 8048a0a8-58cc-42cb-b92b-801f0e35392c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Transaction Count' = DISTINCTCOUNT(FACT_SALES[TRANSACTIONID])
		formatString: 0
		displayFolder: Basic measure
		lineageTag: c82eb283-9f40-4c75-aedc-b0b94b51e9ca

	measure 'Active Customer' = DISTINCTCOUNT(FACT_SALES[CUSTOMERID])
		formatString: 0
		displayFolder: Basic measure
		lineageTag: 152223d3-033e-49dd-a95a-400e6631ea30

	measure ASP = DIVIDE([Revenue],sum(FACT_SALES[UNITS]))
		displayFolder: Basic measure
		lineageTag: aaa99eb1-415d-4e6d-8030-90c56543c907

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure IPB = DIVIDE(SUM(FACT_SALES[UNITS]), [Transaction Count])
		displayFolder: Basic measure
		lineageTag: 373acf33-b593-41f3-8227-233883126aff

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Annual Spend' = DIVIDE([Revenue],[Active Customer])
		displayFolder: Basic measure
		lineageTag: 65fdd59c-9dbe-41c0-81ce-16c0d529dd5d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Basket Value' = DIVIDE([Revenue],[Transaction Count])
		displayFolder: Basic measure
		lineageTag: a436dcd4-9c00-4ec1-bd82-747ad56afc2b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg frequency' = DIVIDE([Transaction Count],[Active Customer])
		displayFolder: Basic measure
		lineageTag: 2edcffac-d88a-4110-8247-e81ee755a1c0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Customer Unites' = DIVIDE(SUM(FACT_SALES[UNITPRICE]),[Active Customer])
		displayFolder: Basic measure
		lineageTag: 3b379ede-7642-4820-aa38-8551b99e2413

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure UnitSold = sum(FACT_SALES[UNITS])
		formatString: #,0
		displayFolder: Basic measure
		lineageTag: b7d90a41-976c-4d32-a28f-c83658de6a4d

	measure 'Net Sales' = sumx(FACT_SALES,FACT_SALES[UNITPRICE]* FACT_SALES[UNITS])
		displayFolder: Basic measure
		lineageTag: 04e1d2da-f203-4a1e-ae77-367165c4933e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Discount' = [Net Sales] - [Revenue]
		displayFolder: Basic measure
		lineageTag: 44a11df2-e3b0-405b-8b7a-e725010bdb66

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'AVG asp' = AVERAGE(DIM_PRODUCT[ASP])
		displayFolder: Basic measure
		lineageTag: 35b2c7a1-00c3-478a-9e72-ebd18a0522d3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'rev share subcategory %' = DIVIDE([Revenue],CALCULATE([Revenue],all(DIM_PRODUCT[SUBCATEGORY])))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Basic measure
		lineageTag: e1b3c62d-39f6-474b-b1e2-f6d7bd75b674

	column 'Bucket ID' = int(HOUR(FACT_SALES[TIMESTAMP])/3)
		formatString: 0
		lineageTag: 2c554844-6946-4698-9239-5257c129457f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column DateKey = year(FACT_SALES[DATE])* 10000 + MONTH(FACT_SALES[DATE])*100 + DAY(FACT_SALES[DATE])
		dataType: int64
		formatString: 0
		lineageTag: 2c35271b-0b48-4b83-ab16-e87dbea4e9c3
		summarizeBy: count

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column 'Period Bucket' =
			
			VAR hr = hour(FACT_SALES[TIMESTAMP])
			RETURN
			SWITCH(TRUE(),
			HR<3,"00 AM - 03 AM",
			HR<6,"03 AM - 06 AM",
			HR<9,"06 AM - 09 AM",
			HR<12,"09 AM - 12 PM",
			HR<15,"12 PM - 03 PM",
			HR<18,"03 PM - 06 PM",
			HR<21,"06 PM - 09 PM","09 PM - 12 AM"
			)
		lineageTag: e69c8a2b-14ca-4794-a519-c3dc1bbd30d2
		summarizeBy: none
		sortByColumn: 'Period sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Period sort' =
			
			VAR hr = hour(FACT_SALES[TIMESTAMP])
			RETURN
			SWITCH(TRUE(),
			hr < 3, 1,
			hr < 6, 2,
			hr < 9 , 3,
			hr < 12, 4,
			hr < 15, 5,
			hr < 18, 6,
			hr < 21, 7,
			8)
		formatString: 0
		lineageTag: 5f0ecdf8-1eee-40e1-b15e-f9fc5e15c5c7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

