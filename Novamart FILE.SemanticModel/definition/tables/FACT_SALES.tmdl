	partition FACT_SALES = m
		mode: import
		source =
				let
				    Source = SharePoint.Files(
				        "https://gwcteq-my.sharepoint.com/personal/rija_ravichandran_gwcdata_ai",
				        [ApiVersion = 15]
				    ),
				    FilteredFiles =
				        Table.SelectRows(
				            Source,
				            each [Name] = "FactSales.xlsx"
				                and [Folder Path] = "https://gwcteq-my.sharepoint.com/personal/rija_ravichandran_gwcdata_ai/Documents/original_nova_mart/"
				        ),
				    File = FilteredFiles{0}[Content],
				    Excel_Source = Excel.Workbook(File, true),
				    #"Navigated_Sheet" = Excel_Source{0}[Data],
				    #"Renamed Columns" =
				        Table.RenameColumns(
				            Navigated_Sheet,
				            {
				                {"ChannelID","CHANNELID"},
				                {"PaymentID","PAYMENTID"},
				                {"Date","DATE"},
				                {"Timestamp","TIMESTAMP"},
				                {"Units","UNITS"},
				                {"UnitPrice","UNITPRICE"},
				                {"DiscountPct","DISCOUNTPCT"},
				                {"SalesAmount","SALESAMOUNT"},
				                {"BrandName","BRANDNAME"},
				                {"ChannelName","CHANNELNAME"},
				                {"PaymentMethodName","PAYMENTMETHODNAME"},
				                {"StoreState","STORESTATE"},
				                {"StoreRBU","STORERBU"},
				                {"ProductID","PRODUCTID"},
				                {"SalesID","SALESID"},
				                {"StoreID","STOREID"},
				                {"CustomerID","CUSTOMERID"},
				                {"TransactionID","TRANSACTIONID"}
				            },
				            MissingField.Ignore
				        ),
				    #"Filtered Rows" =
				        Table.SelectRows(
				            #"Renamed Columns",
				            each true
				        ),
				    #"Changed Type" = Table.TransformColumnTypes(#"Filtered Rows",{{"TIMESTAMP", type datetime}, {"UNITPRICE", type number}, {"UNITS", Int64.Type}, {"DISCOUNTPCT", Int64.Type}, {"SALESAMOUNT", type number}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

