	column WeekName =
			
			var wk = Date_Dimension[week]
			RETURN
			SWITCH(TRUE(),wk= 1 ,"Mon", wk = 2, "Tue",wk = 3,"Wed",wk = 4,"Thu",wk = 5, "Fir",wk = 6, "Sat",wk = 7,"Sun")
		lineageTag: 6882ce6c-ea64-4e04-9ddf-dd8da5cb91d9
		summarizeBy: none
		sortByColumn: week

		annotation SummarizationSetBy = Automatic

	partition Date_Dimension = calculated
		mode: import
		source =
				
				VAR MinDate = MIN('FACT_SALES'[TIMESTAMP])
				VAR MaxDate = MAX('FACT_SALES'[TIMESTAMP])
				VAR DateColumn = CALENDAR(MinDate, MaxDate)
				RETURN
				ADDCOLUMNS(DateColumn,"DateKey",year([Date])* 10000 + MONTH([Date])*100 + DAY([Date]), "Year",Format([Date],"YYYY"),"Month" , MONTH([Date]), "MonthName",FORMAT([Date],"MMMM"),"week",WEEKDAY([Date]),"yearmonth", FORMAT([Date],"YY") & "-"& FORMAT([Date],"MM"), "Quater",  "Q" & QUARTER([Date]),"YearMonthNUm",YEAR([Date])* 100 + MONTH([Date]),"DayName",FORMAT([Date],"MMM")& " " & FORMAT([Date],"DD"),"WeekNum",WEEKNUM([Date]),"Week Format","Y" & FORMAT([Date],"YY") & "M" & FORMAT([date],"MM") & "W" & WEEKNUM([Date]),"DayofWeek",FORMAT([Date],"MMM") & WEEKDAY([Date],2),"IsWeekday",if(WEEKDAY([Date],2)> 5,"Weekend","Weekday")
				)

	annotation PBI_Id = a0fe15eda1664ebcb73e9c0ce19b321d

