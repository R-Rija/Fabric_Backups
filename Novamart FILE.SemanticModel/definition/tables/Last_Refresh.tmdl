table Last_Refresh
	lineageTag: b026983e-b04f-4d13-a6ec-18fb92ae2c98

	measure 'last Refresh Time' = VALUES(Last_Refresh[Date Last Refreshed])
		lineageTag: 5e076f24-7f26-4b63-8aa1-b737064a7f82

		formatStringDefinition = "0"

	measure 'matrix color' =
			var calcitem = SELECTEDVALUE('Calculation group'[Metric])
			var value_ = SELECTEDMEASURE()
			RETURN
			SWITCH(
			    TRUE(),calcitem in {"vLW %","vL4W%"} && Value_ < 0,"#FF0000",
			    calcitem IN{"vLW%","vL4W"} && value_ >= 0,"#008000", "#000000")
		lineageTag: 4094e11c-70b4-4e09-9d93-cfddfefdff7e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Date Last Refreshed'
