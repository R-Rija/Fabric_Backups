	measure dataavilabilty = max(FACT_SALES[TIMESTAMP])
		formatString: General Date
		displayFolder: refresh
		lineageTag: d8522efd-0d33-4a2c-9b42-2944986334bc

	measure 'TD Unints' = [UnitSold]
		displayFolder: Weekly measure
		lineageTag: 924d94aa-3292-4543-a79c-dd267df24b0a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LW Revenue' =
			
			VAR prevsales =
			CALCULATE([Revenue],DATEADD(Date_Dimension[Date],-7,DAY))
			RETURN
			COALESCE(prevsales,0)
		displayFolder: Weekly measure
		lineageTag: f311430b-aa8c-4397-832c-a6b53a935655

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LW Units' = CALCULATE([UnitSold],DATEADD(Date_Dimension[Date],-7,DAY))
		displayFolder: Weekly measure
		lineageTag: 3bc09d83-99f8-480d-b404-29e68d4a30ef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'vLW% Revenue' = DIVIDE([vLW Revenue],[LW Revenue])
		displayFolder: Weekly measure
		lineageTag: 6985c5ba-1412-4dde-9dad-bbb2b5c940d3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'vLW Revenue' = [TD Revenue] - [LW Revenue]
		displayFolder: Weekly measure
		lineageTag: 4d879ca5-be12-4b2d-b0d9-bfa6007d219f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'vLW Unites' = [TD Unints] - [LW Units]
		displayFolder: Weekly measure
		lineageTag: 0f13e995-abe8-4bc9-a48f-26b0520a1e4a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'vLW% Unites' = DIVIDE([vLW Unites],[LW Units])
		displayFolder: Weekly measure
		lineageTag: f22f2a8b-3501-4642-98c4-e1f5095ead7e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg.L4W Revenue' =
			
			VAR w1 = CALCULATE([Revenue],DATEADD(Date_Dimension[Date],-7,DAY))
			VAR w2 = CALCULATE([Revenue],DATEADD(Date_Dimension[Date],-14,DAY))
			VAR w3 = CALCULATE([Revenue],DATEADD(Date_Dimension[Date],-21,DAY))
			VAR w4 = CALCULATE([Revenue],DATEADD(Date_Dimension[Date],-28,DAY))
			RETURN
			DIVIDE(w1 + w2 + w3 + w4 , 4)
		displayFolder: Weekly measure
		lineageTag: afd82dcc-9d0f-4f07-83e7-2da675d327c5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg.L4W Units' =
			
			VAR w1 = CALCULATE([UnitSold],DATEADD(Date_Dimension[Date],-7,DAY))
			VAR w2 = CALCULATE([UnitSold],DATEADD(Date_Dimension[Date],-14,DAY))
			VAR w3 = CALCULATE([UnitSold],DATEADD(Date_Dimension[Date],-21,DAY))
			VAR w4 = CALCULATE([UnitSold],DATEADD(Date_Dimension[Date],-28,DAY))
			RETURN
			DIVIDE(w1 + w2 + w3 + w4 , 4)
		displayFolder: Weekly measure
		lineageTag: 6f692ada-59bf-4539-a1b7-537c72c50a61

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'vL4W Revenue' = [TD Revenue] - [Avg.L4W Revenue]
