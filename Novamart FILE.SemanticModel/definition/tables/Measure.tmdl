	measure 'Dynamic Label Color' = ```
			
			VAR AllVisibleBuckets = ALLSELECTED('Time_Table'[TimeFrame])
			VAR MaxValue = MAXX(AllVisibleBuckets, SELECTEDMEASURE())
			VAR MinValue = MINX(AllVisibleBuckets, SELECTEDMEASURE())
			VAR CurrentValue = SELECTEDMEASURE()
			RETURN 
			    SWITCH(
			        TRUE(),
			        CurrentValue = MaxValue, "#107C41",
			        CurrentValue = MinValue, "#A80000",
