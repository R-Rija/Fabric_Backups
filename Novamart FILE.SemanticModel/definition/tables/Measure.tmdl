	measure 'vl4w %' = ```
			VAR _SelectedMetric = SELECTEDVALUE('Calculation group'[Metric])
			VAR TD = SELECTEDMEASURE()
			VAR LW = CALCULATE(
			    SELECTEDMEASURE(), 
			    REMOVEFILTERS(Date_Dimension), 
			    DATEADD(Date_Dimension[Date], -7, DAY)
			)
			
			RETURN
			IF(
			    _SelectedMetric = "vLW %", 
			    IF(ISBLANK(TD), BLANK(), DIVIDE(TD - LW, LW)),
			    BLANK()
			)
			```
