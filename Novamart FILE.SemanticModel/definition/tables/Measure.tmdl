	measure 'Color % Revenue v4lw' =
			
			VAR metricname = SELECTEDVALUE('Calculation group'[Metric])
			VAR _Current = [Revenue]
			VAR _LW = CALCULATE([Revenue], REMOVEFILTERS('Calculation group'), 'Calculation group'[Metric] = "LW")
			VAR _L4W = CALCULATE([Revenue], REMOVEFILTERS('Calculation group'), 'Calculation group'[Metric] = "Avg.L4W")
			VAR _vLW_Pct = COALESCE(DIVIDE(_Current - _LW, _LW), 0)
			VAR _vL4W_Pct = COALESCE(DIVIDE(_Current - _L4W, _L4W), 0)
			RETURN
			SWITCH(
			    TRUE(),
			    metricname = "vL4W %" && _vL4W_Pct > 0, 100,
			    metricname = "vL4W %" && _vL4W_Pct < 0, -100,
			    BLANK()
			)
		displayFolder: test for color
		lineageTag: 6e4949f0-52c3-4324-adb3-209da0bd53bc

