			VAR div = DIVIDE(cur - pre,pre)
			RETURN
			SWITCH(TRUE(),div > 0, "Green", div < 0 ,"Red",
			"Grey")
		displayFolder: refresh
		lineageTag: 43a2082c-e40f-4bb0-9326-e9b8382b97f9

