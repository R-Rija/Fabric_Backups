	measure 'last week sales' =
			
			VAR lw = [LW Revenue]
			RETURN
			IF(ISBLANK(lw),BLANK(),
			"vs RS " & FORMAT(lw / 1000000000,"0.00") & " bn LW")
		displayFolder: KPI\last week
