	measure 'data avilability' = ```
			
			var maxdate = CALCULATE(max(FACT_SALES[TIMESTAMP]),all(Date_Dimension),all(FACT_SALES))
			var hr = HOUR(maxdate)
			var endhour = SWITCH(TRUE(),hr<3,"3 am",hr<6,"6 am",hr<9,"9 am",hr<12,"12 pm",hr<15,"3 pm",hr<18,"6 pm",hr<21,"9 pm","12 am")
			var formatteddate = FORMAT(maxdate,"dd-mm-yy")
			return 
			"Data Available untill " & formatteddate & " " & endhour
