	measure 'annual spend per change' = ```
			
			VAR cur = [Annual Spend]
			VAR pre = CALCULATE([Annual Spend], REMOVEFILTERS(Date_Dimension), DATEADD(Date_Dimension[Date], -7, DAY))
			VAR div = DIVIDE(cur - pre, pre)
			VAR formattedValue = FORMAT(div, "+ 0.00 %;-0.00 %;0.00 %") 
			RETURN
			SWITCH(TRUE(),
			div > 0, UNICHAR(129157) & " " & formattedValue,
			div < 0, UNICHAR(129158) & " " & formattedValue,"0.00 %")
