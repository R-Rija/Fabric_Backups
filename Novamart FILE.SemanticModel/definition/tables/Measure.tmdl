		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'rev per change' = ```
			
			VAR cur = [Revenue]
			VAR pre = [LW Revenue]
			VAR div = DIVIDE(cur - pre,pre)
			VAR formattedValue = FORMAT(div, "+ 0.00 %;-0.00 %;0.00 %") 
			RETURN
			    SWITCH(TRUE(),
			        div > 0, UNICHAR(129157) & " " & formattedValue,
			        div < 0, UNICHAR(129158) & " " & formattedValue,
			        "0.00 %"
			    )
			```
		displayFolder: KPI\percentage change
