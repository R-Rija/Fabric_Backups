		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Display value' =
			
			VAR periodselected = SELECTEDVALUE('Period table'[Period])
			VAR metricselected = SELECTEDVALUE('Metric Table'[metric])
			RETURN
			SWITCH(TRUE(),
			periodselected = "TD" && metricselected = "Sales",[Revenue],
			periodselected = "TD" && metricselected = "Units",[UnitSold],
			periodselected = "LW" && metricselected = "Sales",[LW Revenue],
			periodselected = "LW" && metricselected = "Units",[LW Units],
			periodselected = "vLW" && metricselected = "Sales",[vLW Revenue],
			periodselected = "vLW" && metricselected = "Units",[vLW Unites],
			periodselected = "vLW%" && metricselected = "Sales",[vL4W% Revenue],
			periodselected = "vLW%" && metricselected = "Units",[vL4W% Units],
			periodselected = "Avg.L4W" && metricselected = "Sales",[Avg.L4W Revenue],
			periodselected = "Avg.L4W" && metricselected = "Units",[Avg.L4W Units],
			periodselected = "vL4W" && metricselected = "Sales",[vL4W Revenue],
			periodselected = "vL4W" && metricselected = "Units",[vL4W Units],
			periodselected = "vL4W%" && metricselected = "Sales",[vL4W% Revenue],
			periodselected = "vL4W%" && metricselected = "Units",[vL4W% Units])
		displayFolder: Weekly measure
		lineageTag: 7b2f3785-a24c-41f2-89b4-58254cbdf1cd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'vL4W% rev format' =
			
			VAR v = [vL4W% Revenue]
			RETURN
			SWITCH(TRUE(),
			ISBLANK(v),BLANK(),
			v > 0, UNICHAR(9650) & " " & "0.00",
			v< 0, UNICHAR(9660) & " " & "0.00", "0.00")
